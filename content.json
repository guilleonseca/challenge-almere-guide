 "schedule", "day": "Saturday 12 September", "time": "15:40", "title": "First finisher — Elite female, LD EC", "location": "Finish Stadium", "tag": "elite"}, {"id": "s46", "category": "schedule", "day": "Saturday 12 September", "time": "16:00", "title": "Award Ceremony — LD EC Women (expected)", "location": "Finish Stadium", "tag": "elite"}, {"id": "s47", "category": "schedule", "day": "Saturday 12 September", "time": "19:00", "title": "Award Ceremony — Dutch Championship LD", "location": "Holland Triathlon House", "tag": "elite"}, {"id": "s48", "category": "schedule", "day": "Saturday 12 September", "time": "19:15", "title": "Joop Visser Cup & Ruud Graman Cup presentation", "location": "Holland Triathlon House", "tag": "elite"}, {"id": "s49", "category": "schedule", "day": "Saturday 12 September", "time": "23:20", "title": "Last finisher", "location": "Finish Stadium", "tag": "elite"}, {"id": "s50", "category": "schedule", "day": "Saturday 12 September", "time": "13:00", "title": "Registration Marathon open", "location": "Holland Triathlon House", "tag": "marathon"}, {"id": "s51", "category": "schedule", "day": "Saturday 12 September", "time": "16:00", "title": "Registration Marathon closes", "location": "Holland Triathlon House", "tag": "marathon"}, {"id": "s52", "category": "schedule", "day": "Saturday 12 September", "time": "17:00", "title": "Start — Marathon", "location": "Forum", "tag": "marathon"}, {"id": "s53", "category": "schedule", "day": "Sunday 13 September", "time": "11:00", "title": "Award ceremony — LD Elite, EC AG, Dutch AG, Open AG, TriTogether, Aquabike, Anniversary", "location": "Holland Triathlon House", "tag": "elite"}, {"id": "c1", "category": "course", "title": "Long Distance", "detail": "Swim: 2 laps in the Weerwater (3.8km total), starting next to the Theatre on the Esplanade. Bike: CADEX course, 2 laps of 90.7km — along the Weerwater, past the Oostvaardersplassen wildlife reserve. Run: a 900m opening lap, then 4 laps of 10.1km, finishing on the Esplanade. Cut-offs (official Waiver & Rules): bike course closes 17:50, run/finish closes 22:30. Aid stations: Powerbar sports drinks, gels and bars on both bike and run — exact station map is in the Athlete Guide PDF (Important Links tab).", "img": "https://challenge-almere.com/wp-content/uploads/sites/52/2026/08/bike-long-distance.jpg"}, {"id": "c2", "category": "course", "title": "Middle Distance", "detail": "Swim: 1 lap in the Weerwater (1.9km). Bike: CADEX course, 1 lap of 94km — same route as Long Distance's first lap. Run: a 900m opening lap, then 2 laps of 10.1km, finishing on the Esplanade. Cut-offs: Middle Distance doesn't have separately published cut-off times online — confirm exact times in the Athlete Guide PDF (Important Links tab) before race day. Aid stations: Powerbar sports drinks, gels and bars on both bike and run.", "img": "https://challenge-almere.com/wp-content/uploads/sites/52/2026/08/bike-middle-distance-2.jpg"}, {"id": "c3", "category": "course", "title": "Marathon", "detail": "A 1.6km approach loop around the hospital, then 4 laps of 10.15km around the Weerwater and across the Hortus. Start waves from 17:00 (5 waves, 5 min apart), cut-off 23:00 (max 5h40 from the final wave). 6 aid stations on course, roughly every 2km — the first (1.6km mark) is water only, the rest offer water, Powerbar sports drink, cola, gels, crackers and fruit. Drop your green After Race bag at the Forum start — collect it back at the Theatre after finishing.", "img": "https://challenge-almere.com/wp-content/uploads/sites/52/2025/02/run-long-distance.jpg"}, {"id": "c4", "category": "course", "title": "TriTogether Relay (Long & Middle Distance)", "detail": "Same course as the individual triathlon — one team member swims, one bikes, one runs. Long Distance Relay: 3.8km swim / 180km bike / 42.2km run split across the team. Middle Distance Relay: 1.9km swim / 94km bike / 21.1km run split across the team.", "img": "https://challenge-almere.com/wp-content/uploads/sites/52/2026/08/bike-long-distance.jpg"}, {"id": "c5", "category": "course", "title": "Aquabike (Long & Middle Distance)", "detail": "Swim + bike only, no run. Long Distance Aquabike: 3.8km swim, 180km bike. Middle Distance Aquabike: 1.9km swim, 94km bike. Same swim and bike courses as the full triathlon.", "img": "https://challenge-almere.com/wp-content/uploads/sites/52/2026/08/bike-middle-distance-2.jpg"}, {"id": "v1", "category": "venue", "title": "Start / Finish — Esplanade", "detail": "Esplanade Almere, 1315TA. Swim, bike and run all start and finish here — right next to the Theatre."}, {"id": "v2", "category": "venue", "title": "Transition Area (T1 & T2)", "detail": "New for this year — moved to Lumièrepark, about 700m from the Esplanade, for all distances."}, {"id": "v3", "category": "venue", "title": "Post-race recovery — Theatre (Schouwburg)", "detail": "Athlete buffet (hot: pasta, burgers, fries — cold: salads, sandwiches), changing rooms, showers, and massage available here after you finish."}, {"id": "e1", "category": "expo", "title": "Cadomotus", "detail": "45th Anniversary backpack collab — pick up at the Theatre Merchandise Shop"}, {"id": "e2", "category": "expo", "title": "Erdinger Alkoholfrei", "detail": "Official recovery drink partner — main stage with DJ sets"}, {"id": "e3", "category": "expo", "title": "Quintana Roo", "detail": "Official swim course sponsor"}, {"id": "e4", "category": "expo", "title": "Full partner list", "detail": "[PLACEHOLDER — confirm remaining sponsors + booth numbers]"}, {"id": "l1", "category": "links", "title": "Live Tracking", "detail": "[PLACEHOLDER — confirm the 2026 tracking link closer to race day]"}, {"id": "l1b", "category": "links", "title": "Athlete Guide 2026 (PDF)", "detail": "The full official guide — rules, nutrition, everything", "url": "https://drive.google.com/file/d/1RPA87ilhG18xnAqRfMq09ZxUfPddliGG/view"}, {"id": "l2", "category": "links", "title": "Athlete Briefings", "detail": "Elite and Age Group briefing info", "url": "https://challenge-almere.com/race-information/briefing/"}, {"id": "l3", "category": "links", "title": "Startlists", "detail": "Bib numbers by category", "url": "https://challenge-almere.com/startlists/"}, {"id": "l4", "category": "links", "title": "Results", "detail": "Live and past results", "url": "https://challenge-almere.com/history/past-results/"}, {"id": "l5", "category": "links", "title": "Time Schedule (official)", "detail": "The source this app's Schedule tab is built from", "url": "https://challenge-almere.com/race-information/time-schedule/"}]